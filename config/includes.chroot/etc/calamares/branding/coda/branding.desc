---
componentName:  coda

# windowExpanding can be normal, fullscreen, or noexpand
windowExpanding: normal
windowSize: 800px,520px
windowPlacement: center

# sidebar can be widget, qml, or none
sidebar: widget
navigation: widget

strings:
    productName:         Coda Linux
    shortProductName:    Coda
    version:             0.1.0
    shortVersion:        0.1.0
    versionedName:       Coda Linux 0.1.0
    shortVersionedName:  Coda 0.1.0
    bootloaderEntryName: Coda
    productUrl:          https://github.com/egeexyz/coda
    supportUrl:          https://github.com/egeexyz/coda
    knownIssuesUrl:      https://github.com/egeexyz/coda/issues
    releaseNotesUrl:     https://github.com/egeexyz/coda/releases
    donateUrl:           https://github.com/egeexyz/coda

images:
    productLogo:         "eglabs.webp"
    productIcon:         "eglabs.webp"
    productWelcome:      "eglabs.webp"
    # productWallpaper:  "wallpaper.png"

# slideshow specifies the QML file for the slideshow during install.
# Even if we don't have one right now, Calamares expects the key to exist!
slideshow:               "show.qml"
slideshowAPI: 2

# uploadServer configuration for logs (optional, commented out)
# uploadServer:
#     type: paste
#     url: http://paste.example.com/

style:
   SidebarBackground:    "#2c3133"
   SidebarText:          "#FFFFFF"
   SidebarTextCurrent:   "#292F34"
   SidebarBackgroundCurrent: "#D35400"
