#!/bin/sh
set -e

lb config noauto \
  --distribution testing \
  --security false \
  --updates false \
  --parent-mirror-bootstrap "http://ftp.us.debian.org/debian/" \
  --parent-mirror-chroot "http://ftp.us.debian.org/debian/" \
  --mirror-bootstrap "http://ftp.us.debian.org/debian/" \
  --mirror-chroot "http://ftp.us.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --bootloaders "grub-efi" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --iso-application "Coda Linux Live" \
  --iso-publisher "Coda Linux <https://github.com/egeexyz/coda>" \
  --iso-volume "coda" \
  --memtest none \
  --apt-indices false \
  --firmware-chroot false \
  --bootappend-live "boot=live components username=coda user-fullname=Coda hostname=coda autologin" \
  "${@}"
